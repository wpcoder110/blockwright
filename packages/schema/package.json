{
  "name": "@blockwright/schema",
  "version": "0.1.0",
  "description": "Layout format, validation and template import for Blockwright",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpcoder110/blockwright.git",
    "directory": "packages/schema"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/rm.mjs dist .turbo"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "author": "Ahmer Hassan (https://redlionstech.com)",
  "homepage": "https://github.com/wpcoder110/blockwright#readme",
  "bugs": "https://github.com/wpcoder110/blockwright/issues",
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "payload-cms",
    "cms",
    "page-builder",
    "website-builder",
    "visual-editor",
    "drag-and-drop",
    "blocks",
    "landing-page",
    "nextjs",
    "react",
    "typescript",
    "blockwright",
    "json-schema",
    "validation"
  ]
}
