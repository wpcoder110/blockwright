{
  "name": "@blockwright/payload-plugin",
  "version": "0.1.0-alpha.0",
  "description": "Payload CMS plugin for Blockwright: layout fields, theme templates, site style and form submissions",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc.d.ts",
      "import": "./dist/rsc.js",
      "default": "./dist/rsc.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wpcoder110/blockwright-alpha.git",
    "directory": "packages/payload-plugin"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/rm.mjs dist .turbo"
  },
  "dependencies": {
    "@blockwright/core": "workspace:*",
    "@blockwright/forms": "workspace:*",
    "@blockwright/schema": "workspace:*",
    "@blockwright/widgets-basic": "workspace:*",
    "sanitize-html": "^2.17.0",
    "@blockwright/editor": "workspace:*",
    "@blockwright/renderer": "workspace:*"
  },
  "peerDependencies": {
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "next": "^15.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "payload": "3.89.0",
    "react": "19.2.6",
    "@types/react": "19.2.14",
    "@types/sanitize-html": "^2.16.0",
    "next": "16.3.3",
    "react-dom": "19.2.6"
  }
}
