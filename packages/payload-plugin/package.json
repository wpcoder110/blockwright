{
  "name": "@blockwright/payload-plugin",
  "version": "0.2.0",
  "description": "Payload CMS plugin for Blockwright: layouts, templates, menus, forms and the visual editor",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc.d.ts",
      "import": "./dist/rsc.js",
      "default": "./dist/rsc.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/exports/types.d.ts",
      "import": "./dist/exports/types.js",
      "default": "./dist/exports/types.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpcoder110/blockwright.git",
    "directory": "packages/payload-plugin"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/rm.mjs dist .turbo"
  },
  "dependencies": {
    "@blockwright/core": "workspace:*",
    "@blockwright/forms": "workspace:*",
    "@blockwright/schema": "workspace:*",
    "@blockwright/widgets-basic": "workspace:*",
    "sanitize-html": "^2.17.0",
    "@blockwright/editor": "workspace:*",
    "@blockwright/renderer": "workspace:*",
    "@blockwright/widgets-commerce": "workspace:*"
  },
  "peerDependencies": {
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "next": "^15.0.0 || ^16.0.0",
    "@payloadcms/ui": "^3.0.0"
  },
  "devDependencies": {
    "payload": "3.90.1",
    "react": "19.2.6",
    "@types/react": "19.2.14",
    "@types/sanitize-html": "^2.16.0",
    "next": "16.3.3",
    "react-dom": "19.2.6",
    "@payloadcms/ui": "3.90.1"
  },
  "author": "Ahmer Hassan (https://redlionstech.com)",
  "homepage": "https://github.com/wpcoder110/blockwright#readme",
  "bugs": "https://github.com/wpcoder110/blockwright/issues",
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "payload-cms",
    "cms",
    "page-builder",
    "website-builder",
    "visual-editor",
    "drag-and-drop",
    "blocks",
    "landing-page",
    "nextjs",
    "react",
    "typescript",
    "blockwright",
    "collections"
  ]
}
