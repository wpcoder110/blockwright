{
  "name": "@blockwright/widgets-basic",
  "version": "0.2.0",
  "description": "Built-in widgets for Blockwright, the page builder for Payload CMS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wpcoder110/blockwright.git",
    "directory": "packages/widgets-basic"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/rm.mjs dist .turbo"
  },
  "dependencies": {
    "@blockwright/core": "workspace:*",
    "@blockwright/renderer": "workspace:*",
    "@blockwright/schema": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "author": "Ahmer Hassan (https://redlionstech.com)",
  "homepage": "https://github.com/wpcoder110/blockwright#readme",
  "bugs": "https://github.com/wpcoder110/blockwright/issues",
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "payload-cms",
    "cms",
    "page-builder",
    "website-builder",
    "visual-editor",
    "drag-and-drop",
    "blocks",
    "landing-page",
    "nextjs",
    "react",
    "typescript",
    "blockwright",
    "widgets",
    "components"
  ]
}
