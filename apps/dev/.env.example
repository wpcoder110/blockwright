# Copy to .env (cp .env.example .env). Defaults match docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/blockwright
# Any long random string. Generate one with: openssl rand -hex 24
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Emails from forms go to Mailpit (http://localhost:8025). Remove to log emails to the console instead.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM=hello@blockwright.local
FORMS_EMAIL_TO=owner@blockwright.local
# Max form submissions per visitor per minute
FORMS_RATE_LIMIT=10
